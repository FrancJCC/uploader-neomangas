{
  "name": "neomanga-tools",
  "version": "2.3.5",
  "description": "NeoManga Admin CLI - Upload, Verify, Repair",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg index.js --targets node18-win-x64 --output neomanga-tools.exe --public"
  },

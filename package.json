    "@aws-sdk/lib-storage": "^3.511.0",
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.3.3",
    "inquirer": "^8.2.7",
    "mongoose": "^8.0.0",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "sharp": "^0.32.6",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1",
    "rcedit": "^5.0.2"
  }
}

# ==============================================
# CONFIGURACIÓN GENERAL DE NEOMANGA TOOLS (EXAMPLE)
# ==============================================

# Directorio de descargas (Entrada)
CONTENT_DIR=E:\NeoManga\downloader\downloads

# Base de Datos (MongoDB Atlas)
# Puedes usar MONGO_URI completo o separar USER/PASS
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña
MONGO_URI=mongodb://host1:port,host2:port/database?options

# ==============================================
# CONFIGURACIÓN GLOBAL S3 (Backblaze B2)
# ==============================================
S3_REGION=eu-central-003
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_PUBLIC_URL=https://tu-worker.workers.dev

# ==============================================
# CREDENCIALES POR BUCKET
# ==============================================

# Bucket 1: NeoMangas (Principal / Activo)
NEOMANGAS_NAME=NeoMangas
NEOMANGAS_KEY=tu_access_key_1
NEOMANGAS_SECRET=tu_secret_key_1

# Bucket 2: NeoMangas2 (Reserva)
NEOMANGAS2_NAME=NeoMangas2
NEOMANGAS2_KEY=tu_access_key_2
NEOMANGAS2_SECRET=tu_secret_key_2

# Bucket 3: NeoMangas3 (Reserva)
NEOMANGAS3_NAME=NeoMangas3
NEOMANGAS3_KEY=tu_access_key_3
NEOMANGAS3_SECRET=tu_secret_key_3

# ==============================================
# VARIABLES LEGACY (Compatibilidad)
# ==============================================
S3_BUCKET=NeoMangas
S3_ACCESS_KEY=tu_access_key_global
S3_SECRET_KEY=tu_secret_key_global
